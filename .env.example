# --- Required ---
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Comma-separated chat ids that receive automatic alerts
TELEGRAM_ALERT_CHAT_IDS=
# Who may talk to the bot at all (defaults to alert ids). Protects your
# Anthropic tokens: strangers messaging the bot are rejected. When both
# lists are empty the bot is CLOSED by default (strangers are shown their
# chat_id so the owner can whitelist themselves during setup).
TELEGRAM_ALLOWED_CHAT_IDS=
# true = deliberately run an open bot with no whitelist (not recommended)
ALLOW_PUBLIC_ACCESS=false

# --- Trading costs (backtest reports NET results) ---
TAKER_FEE_PCT=0.05
SLIPPAGE_PCT=0.03

# --- Optional data sources (graceful degradation if unset) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINGLASS_API_KEY=
GLASSNODE_API_KEY=
CRYPTOQUANT_API_KEY=
NEWSAPI_KEY=
FRED_API_KEY=

# --- Model ---
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Instrument ---
SYMBOL=BTCUSDT
SYMBOL_DISPLAY=BTC

# --- Signal engine tuning ---
MIN_DIVERSE_CATEGORIES=3
COOLDOWN_HOURS=4
# Hard cap of delivered alerts per stream over a rolling 24h window
MAX_SIGNALS_PER_DAY=3
# Aggregate risk cap: max simultaneously open (virtual) positions per symbol
# across all profiles; alerts beyond it are sent with a warning, not journaled
MAX_OPEN_TRADES=3
ATR_MULTIPLIER=1.5
RISK_PERCENT=1
ACCOUNT_BALANCE=10000
SCORE_ALERT_MIN=8
SCORE_JOURNAL_MIN=5

# --- Counter-trend exhaustion (require_exhaustion HTF policy) ---
# Bars a counter-trend (bounce) setup must clear before the HTF gate admits it.
# No shipped profile declares require_exhaustion yet, so these are inert today.
# Timeframes that must confirm the reversal
BOUNCE_MIN_REVERSAL_TFS=2
# Corroborating factors required on top of the mandatory conditions
BOUNCE_MIN_OPTIONAL_CONFIRMATIONS=1

# --- Scheduler ---
# Cadence lives in signal profiles (swing hourly, intraday 15m).
ALERT_CHECK_INTERVAL_MINUTES=5
TRADE_CHECK_INTERVAL_MINUTES=15
# Toggle the intraday (15m) analysis stream
ENABLE_FAST_ANALYSIS=true

# --- Exchange (auto = Bybit first, fall back to Binance on geo-block) ---
EXCHANGE=auto

# --- Targets & stop as R-multiples (tune win-rate vs reward, verify via /backtest) ---
# Closer TP1 => higher win-rate, smaller reward. Format: "TP1,TP2".
SWING_TARGETS=1.5,3.0
SWING_ATR_MULT=1.5

# --- Minimum expected move per mode (points; 1 pt = 1 USDT for BTC).
# A scenario-quality filter (NO_TRADE below it), never a take-profit.
INTRADAY_MIN_MOVE_PTS=500
SWING_MIN_MOVE_PTS=1500
POSITION_MIN_MOVE_PTS=3000
# Per-mode confidence / risk-reward minimums (override the global ones)
#INTRADAY_MIN_CONFIDENCE=0.3
#SWING_MIN_RR=1.5
INTRADAY_TARGETS=1.0,2.0
INTRADAY_ATR_MULT=1.2

# --- Reversal (bottom/top) alerts ---
ENABLE_REVERSAL_ALERTS=true
# Timeframes (of 1H/4H/12H/1D) that must confirm before an alert fires
REVERSAL_ALERT_MIN_TFS=2
REVERSAL_ALERT_COOLDOWN_HOURS=4

# --- Forecast observability ---
# Record EVERY analysis run (incl. WAIT/NO_TRADE/blocked) in the forecasts
# table and track what price did afterwards.
ENABLE_FORECAST_LEDGER=true
OUTCOME_TRACK_INTERVAL_MINUTES=30
# Stamped on every forecast row (separate records across prompt generations)
#PROMPT_VERSION=2026-07-obs-1
# Max seconds between entry-candle close and the decision for ENTER to stay
# executable; beyond it the signal is downgraded to WAIT.
#INTRADAY_MAX_DELAY_SEC=180
#SWING_MAX_DELAY_SEC=900
#POSITION_MAX_DELAY_SEC=1800

# --- Operating mode ---
# DRY_RUN=true runs the full pipeline but does NOT send Telegram alerts.
# Set to false to enable real notifications.
DRY_RUN=true

# Inside DRY_RUN, deliver signal/lifecycle/reversal messages anyway, each
# prefixed with a "🧪 DRY-RUN / MANUAL ONLY" banner. Lets you trade manually
# off the bot's output while no trade is auto-recorded. Ignored when
# DRY_RUN=false.
SEND_DRY_RUN_ALERTS=false

# --- Position stream (multi-day 2000-5000pt moves) ---
ENABLE_POSITION_ANALYSIS=true
POSITION_TARGETS=1.2,2.5
POSITION_ATR_MULT=1.2

# --- Bounce stream (counter-trend mean reversion) — DISABLED BY DEFAULT ---
# The "bounce" profile is the only one allowed to trade against the 1D trend,
# and only on confirmed exhaustion (require_exhaustion HTF policy). It is
# OBSERVATION-ONLY: even when enabled it just records forecasts, and never
# emits a signal, a Telegram alert or a journal trade. With the flag false no
# bounce scheduler job is registered at all.
ENABLE_BOUNCE_PROFILE=false
BOUNCE_TARGETS=1.0,2.0
BOUNCE_ATR_MULT=1.2
