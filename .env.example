# --- Required ---
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Comma-separated chat ids that receive automatic alerts
TELEGRAM_ALERT_CHAT_IDS=

# --- Optional data sources (graceful degradation if unset) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINGLASS_API_KEY=
GLASSNODE_API_KEY=
CRYPTOQUANT_API_KEY=
NEWSAPI_KEY=
FRED_API_KEY=

# --- Model ---
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Instrument ---
SYMBOL=BTCUSDT
SYMBOL_DISPLAY=BTC

# --- Signal engine tuning ---
MIN_DIVERSE_CATEGORIES=3
COOLDOWN_HOURS=4
MAX_SIGNALS_PER_DAY=3
ATR_MULTIPLIER=1.5
RISK_PERCENT=1
ACCOUNT_BALANCE=10000
SCORE_ALERT_MIN=8
SCORE_JOURNAL_MIN=5

# --- Scheduler ---
ANALYSIS_INTERVAL_HOURS=4
ALERT_CHECK_INTERVAL_MINUTES=5

# --- Operating mode ---
# DRY_RUN=true runs the full pipeline but does NOT send Telegram alerts.
# Set to false to enable real notifications.
DRY_RUN=true
